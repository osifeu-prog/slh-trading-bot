services:
  api:
    build: .
    container_name: slh_api
    restart: unless-stopped
    ports:
      - "8080:8080"
    env_file:
      - .env
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 20s
      timeout: 5s
      retries: 3

  supervisor:
    build: .
    container_name: slh_supervisor
    restart: unless-stopped
    env_file:
      - .env
    command: python supervisor_agent.py

  trader:
    build: .
    container_name: slh_trader
    restart: unless-stopped
    env_file:
      - .env
    command: python main_live.py
    depends_on:
      api:
        condition: service_healthy
